# Apache settings for the Korilus PWA (Veebimajutus servers run Apache).

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

<IfModule mod_headers.c>
  # The server-wide security policy (from the dsgnr.ee setup) only allows fonts from
  # Google, which blocks Korilus's own font files. Replace it with one for this app.
  Header unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"

  # Always check for a new version of the app shell and service worker,
  # otherwise phones keep running an old build after an upload.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Built files have a content hash in their name, so they never change.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
