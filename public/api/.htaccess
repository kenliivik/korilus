# Only the endpoints are for browsers. Everything else (the data folder, the schema, the helper and command-line scripts,
# and any new helper file) stays private, so a new endpoint has to be added to the second list.
<FilesMatch "\.(php|sql)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(account|content|feedback|groups|login|myrecipes|notes|pantry|push|settings|spots|upload|visits)\.php$">
  Require all granted
</FilesMatch>
RedirectMatch 404 ^/api/data(/|$)
