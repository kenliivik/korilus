# Only the endpoints are for browsers. The data folder, the schema and the helper and command-line scripts stay private.
<FilesMatch "^(store|webpush|send|auth|admin-password|config\.example|db|session|mail|migrate|create-user)\.php$|\.sql$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/api/data(/|$)
